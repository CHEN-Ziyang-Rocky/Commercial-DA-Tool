PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=dashboard
DB_PASS=dashboard_local_only
DB_NAME=commercial_da
REDIS_URL=redis://127.0.0.1:6380
# Replace with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ALLOW_REGISTRATION=false
VISITOR_EMAIL=visitor@example.com
VISITOR_PASSWORD=ReplaceWithYourVisitorPassword
# Used only by npm run seed:admin; public registration always creates a user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional public SQL aggregation cache. Default off until measured.
CACHE_ENABLED=false
CACHE_NAMESPACE=local:shared
